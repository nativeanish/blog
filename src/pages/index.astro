---
import BaseLayout from '../layouts/BaseLayout.astro';
import HudHeader from '../components/HudHeader.astro';
import HeroIdentity from '../components/HeroIdentity.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Projects from '../components/Projects.astro';
import Journey from '../components/Journey.astro';
import Contact from '../components/Contact.astro';
import HudFooter from '../components/HudFooter.astro';
import Soundtrack from '../components/Soundtrack.astro';
---

<BaseLayout>
  <HudHeader />
  <main id="main">
    <HeroIdentity />
    <About />
    <Skills />
    <Projects />
    <Journey />
    <Contact />
  </main>
  <HudFooter />
  <Soundtrack />
</BaseLayout>
