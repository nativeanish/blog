---
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="A tiny hello world site built with Astro." />
    <title>Hello from Astro</title>
  </head>
  <body>
    <main class="page-shell">
      <nav class="topbar" aria-label="Main navigation">
        <a class="brand" href={import.meta.env.BASE_URL}>astro<span>;</span></a>
        <span class="status"><i></i> online</span>
      </nav>

      <section class="hero" aria-labelledby="page-title">
        <p class="eyebrow">your first little corner of the web</p>
        <h1 id="page-title">Hello,<br /><em>world.</em></h1>
        <p class="intro">
          A clean starting point for your blog, made with Astro and ready to
          ship on GitHub Pages.
        </p>
        <a class="button" href="https://astro.build" target="_blank" rel="noreferrer">
          Explore Astro <span aria-hidden="true">↗</span>
        </a>
      </section>

      <footer>
        <span>Built with Astro</span>
        <span>{year}</span>
      </footer>
    </main>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;600;700;800&display=swap');

  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    color: #f6f2e9;
    background: #15221e;
    font-family: 'Manrope', sans-serif;
  }

  .page-shell {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding: 28px clamp(24px, 6vw, 88px) 30px;
    overflow: hidden;
    background: radial-gradient(circle at 80% 12%, #365643 0, transparent 28%), linear-gradient(135deg, #15221e 0%, #1e3027 58%, #384a37 100%);
  }

  .topbar,
  footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    color: #f6f2e9;
    font-family: 'DM Mono', monospace;
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .brand span,
  .eyebrow {
    color: #e3ab58;
  }

  .status,
  footer {
    color: #c1ccbf;
    font-family: 'DM Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .status i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #a8d27c;
    box-shadow: 0 0 14px #a8d27c;
  }

  .hero {
    width: min(760px, 100%);
    margin: auto 0;
    padding: clamp(74px, 13vh, 150px) 0;
  }

  .eyebrow {
    margin: 0 0 28px;
    font-family: 'DM Mono', monospace;
    font-size: 0.76rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 680px;
    margin: 0;
    color: #f6f2e9;
    font-size: clamp(4.3rem, 12vw, 9.7rem);
    font-weight: 800;
    letter-spacing: -0.075em;
    line-height: 0.83;
  }

  h1 em {
    color: #b9d991;
    font-family: Georgia, serif;
    font-weight: 400;
    letter-spacing: -0.08em;
  }

  .intro {
    max-width: 410px;
    margin: 42px 0 32px;
    color: #c1ccbf;
    font-size: clamp(1rem, 1.8vw, 1.18rem);
    line-height: 1.65;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    padding: 15px 18px 15px 20px;
    color: #15221e;
    background: #e3ab58;
    font-size: 0.88rem;
    font-weight: 800;
    text-decoration: none;
    transition: background 180ms ease, transform 180ms ease;
  }

  .button:hover {
    background: #f0bd70;
    transform: translateY(-3px);
  }

  footer {
    border-top: 1px solid rgb(246 242 233 / 18%);
    padding-top: 18px;
  }

  @media (max-width: 520px) {
    .page-shell {
      padding: 22px 22px 24px;
    }

    .hero {
      padding: 92px 0;
    }

    footer {
      font-size: 0.65rem;
    }
  }
</style>