---
// Botanical Garden Footer
const currentYear = new Date().getFullYear();
---
<footer class="hud-footer" role="contentinfo">
  <div class="footer-left">
    <div class="footer-meta-item">
      <span class="meta-indicator" aria-hidden="true"></span>
      <span class="meta-label">SANCTUARY:</span>
      <span class="meta-value">HIMALAYAN VALLEY // NP</span>
    </div>
  </div>

  <div class="footer-center">
    <a href="mailto:hello@guptaanish.com.np" class="footer-link" data-cursor="pointer">
      <span class="link-icon" aria-hidden="true">✉</span>
      <span>hello@guptaanish.com.np</span>
    </a>
    <span class="footer-sep" aria-hidden="true">/</span>
    <a href="https://instagram.com/nativeanish" target="_blank" rel="noopener noreferrer" class="footer-link" data-cursor="pointer">
      <span class="link-icon" aria-hidden="true">↗</span>
      <span>instagram.com/nativeanish</span>
    </a>
  </div>

  <div class="footer-right">
    <div class="footer-meta-item">
      <span class="meta-label">CULTIVATED BY:</span>
      <span class="meta-value">ANISH © {currentYear}</span>
    </div>
  </div>
</footer>

<style>
  .hud-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 16px;
    z-index: 20;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-dim);
    border-top: 1px solid rgba(20, 45, 30, 0.08);
    padding-top: 18px;
    opacity: 0;
    animation: hud-footer-reveal 1.2s var(--ease-cinematic) 0.6s forwards;
  }

  .footer-left,
  .footer-right,
  .footer-center {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    letter-spacing: 0.06em;
  }

  .meta-indicator {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-sage);
    box-shadow: 0 0 6px rgba(82, 183, 136, 0.8);
  }

  .meta-label {
    color: var(--color-text-dim);
    font-weight: 500;
  }

  .meta-value {
    color: var(--color-text-secondary);
    font-weight: 600;
  }

  .footer-link {
    color: var(--color-text-secondary);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.25s ease, transform 0.25s ease;
  }

  .footer-link:hover {
    color: var(--color-leaf);
    transform: translateY(-1px);
  }

  .link-icon {
    font-size: 0.8rem;
    color: var(--color-leaf);
  }

  .footer-sep {
    color: var(--color-border);
  }

  @keyframes hud-footer-reveal {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 860px) {
    .footer-center {
      display: none;
    }
    .hud-footer {
      font-size: 0.65rem;
      padding-top: 14px;
    }
  }

  @media (max-width: 480px) {
    .footer-left {
      display: none;
    }
    .hud-footer {
      justify-content: center;
    }
  }
</style>
