---
// Botanical Garden Footer
const currentYear = new Date().getFullYear();
---
<footer class="hud-footer" role="contentinfo">
  <div class="footer-left">
    <div class="footer-meta-item">
      <span class="meta-indicator" aria-hidden="true"></span>
      <span class="meta-label">SANCTUARY:</span>
      <span class="meta-value">HIMALAYAN VALLEY // NP</span>
    </div>
  </div>

  <div class="footer-center">
    <div class="interaction-hint">
      <span class="reticle-icon" aria-hidden="true"></span>
      <span class="hint-text">BREEZE & POLLEN DRIFT ACTIVE</span>
    </div>
  </div>

  <div class="footer-right">
    <div class="footer-meta-item">
      <span class="meta-label">CULTIVATED BY:</span>
      <span class="meta-value">ANISH © {currentYear}</span>
    </div>
  </div>
</footer>

<style>
  .hud-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 16px;
    z-index: 20;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-dim);
    border-top: 1px solid rgba(20, 45, 30, 0.08);
    padding-top: 18px;
    opacity: 0;
    animation: hud-footer-reveal 1.2s var(--ease-cinematic) 0.6s forwards;
  }

  .footer-left,
  .footer-right,
  .footer-center {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    letter-spacing: 0.06em;
  }

  .meta-indicator {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-sage);
    box-shadow: 0 0 6px rgba(82, 183, 136, 0.8);
  }

  .meta-label {
    color: var(--color-text-dim);
    font-weight: 500;
  }

  .meta-value {
    color: var(--color-text-secondary);
    font-weight: 600;
  }

  .interaction-hint {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
  }

  .reticle-icon {
    width: 8px;
    height: 8px;
    border: 1.5px solid var(--color-leaf);
    border-radius: 50%;
    animation: pulse-bloom 2.6s infinite ease-in-out;
  }

  @keyframes pulse-bloom {
    0%, 100% {
      transform: scale(0.9);
      opacity: 0.5;
    }
    50% {
      transform: scale(1.3);
      opacity: 1;
    }
  }

  @keyframes hud-footer-reveal {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .footer-center {
      display: none;
    }
    .hud-footer {
      font-size: 0.65rem;
      padding-top: 14px;
    }
  }

  @media (max-width: 480px) {
    .footer-left {
      display: none;
    }
    .hud-footer {
      justify-content: center;
    }
  }
</style>
