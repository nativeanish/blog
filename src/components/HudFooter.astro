---
import { person } from '../data/portfolio';
import Icon from './Icon.astro';
---

<footer class="footer wrap micro">
  <span>© {new Date().getFullYear()} ANISH GUPTA</span>
  <div>
    <a href={'mailto:' + person.email}>
      EMAIL <Icon size={12} />
    </a>
    <a href={person.instagram} target="_blank" rel="noopener noreferrer">
      INSTAGRAM <Icon size={12} />
    </a>
    <a href={person.site}>GUPTAANISH.COM.NP</a>
  </div>
  <a href="#home">
    BACK TO TOP{' '}
    <span class="up-arrow">
      <Icon name="down" size={14} />
    </span>
  </a>
</footer>
