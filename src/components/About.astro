---
import Icon from './Icon.astro';
---

<section id="about" class="section about wrap" aria-labelledby="about-title">
  <div class="section-kicker micro">
    <span>02 / THE PERSON</span>
    <span lang="ne">परिचय</span>
  </div>
  <div class="about-grid">
    <div class="about-heading" data-reveal>
      <h2 id="about-title">
        Rooted here.
        <br />
        Thinking <em>everywhere.</em>
      </h2>
      <div class="origin-stamp">
        <Icon name="mountain" size={34} />
        <span class="micro">
          KATHMANDU, NEPAL
          <br />
          <span class="muted">LOCAL ROOTS. OPEN HORIZONS.</span>
        </span>
      </div>
    </div>
    <div class="about-copy" data-reveal>
      <p class="lead">
        I’m Anish, a creative developer with a curiosity for what happens where
        design, code, and intelligence meet.
      </p>
      <p>
        Based in Kathmandu, I’m drawn to digital experiences that feel
        considered: a thoughtful interaction, an unexpected detail, a sense of
        place.
      </p>
      <p>
        This is my corner of the web. A space for making, experimenting, and
        learning in public—with a little of Nepal woven into every pixel.
      </p>
      <a class="text-link" href="#skills">
        The things I’m exploring <Icon name="down" size={16} />
      </a>
    </div>
  </div>
</section>
