---
import Icon from './Icon.astro';
---

<site-header class="site-header">
  <header class="header-inner wrap">
    <a href="#home" class="brand" aria-label="Anish Gupta, home">
      <svg
        class="brand-mark"
        width="28"
        height="34"
        viewBox="0 0 28 34"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M3 31V3l21 12H8l17 13H3Z"
          stroke="currentColor"
          stroke-width="1.5"
        />
        <path d="M3 3v28" stroke="#ed6d60" stroke-width="3" />
      </svg>
      <span>
        ANISH GUPTA<span class="brand-sub">A PERSONAL EXPLORATION</span>
      </span>
    </a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="main-nav">
      <span data-menu-label>Menu</span>
      <span class="menu-lines" aria-hidden="true"></span>
    </button>
    <nav id="main-nav" aria-label="Main navigation">
      <a href="#about">About</a>
      <a href="#work">Work</a>
      <a href="#journey">Journey</a>
      <a href="#contact" class="nav-contact">
        Let’s talk <Icon size={14} />
      </a>
    </nav>
  </header>
</site-header>
<script src="../scripts/interface.ts"></script>
