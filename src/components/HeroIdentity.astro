---
import Icon from './Icon.astro';
import Landscape from './Landscape.astro';
import NepalClock from './NepalClock.astro';
---

<section id="home" class="hero" aria-labelledby="hero-title">
  <Landscape />
  <div class="hero-topline wrap micro">
    <span>
      <i class="signal-dot"></i> ROOTED IN NEPAL. REACHING BEYOND.
    </span>
    <span class="hero-edition">
      PERSONAL PORTFOLIO / 2026 &nbsp; — &nbsp; <NepalClock />
    </span>
  </div>
  <div class="hero-content wrap">
    <p class="hero-greeting micro">
      <span lang="ne">नमस्ते</span> &nbsp; / &nbsp; HELLO, I’M
    </p>
    <h1 id="hero-title">
      <span class="nepali-name" lang="ne">
        अनिष
      </span>
      <span class="english-name">
        Anish Gupta<span class="name-period">.</span>
      </span>
    </h1>
    <p class="hero-role">
      Creative Developer <span>/</span> AI &amp; ML Enthusiast
    </p>
    <p class="hero-description">
      A little code. A little curiosity.
      <br />A different way to see the digital world.
    </p>
    <div class="hero-actions">
      <a href="#work" class="button button-primary">
        Explore my work <Icon size={17} />
      </a>
      <a href="#contact" class="text-link">
        Contact me <Icon size={16} />
      </a>
    </div>
  </div>
  <div class="landscape-caption micro" aria-hidden="true">
    <span class="caption-cross">+</span>
    <span>
      HIMALAYAN SIGNAL
      <br />
      <span class="muted">A STUDY IN FORM &amp; POSSIBILITY</span>
    </span>
  </div>
  <div class="hero-bottom wrap micro">
    <a href="#about">
      <span class="scroll-icon">
        <Icon name="down" size={15} />
      </span>{' '}
      SCROLL TO EXPLORE
    </a>
    <span class="coordinates">
      27.7172° N &nbsp; 85.3240° E <span class="muted">/ KATHMANDU, NP</span>
    </span>
    <span class="page-count">
      01 <span class="muted">— 06</span>
    </span>
  </div>
</section>
