---
// Minimal Scroll Progress Track
---
<nav class="scroll-tracker" aria-label="Page Sections">
  <div class="tracker-line" aria-hidden="true">
    <div id="tracker-fill" class="tracker-fill"></div>
  </div>

  <div class="tracker-nodes">
    <a href="#stage-01" class="tracker-node is-active" data-stage="1" aria-label="Go to Chapter 01: The Seed" data-cursor="pointer">
      <span class="node-label">01</span>
      <span class="node-tooltip">SEED</span>
    </a>
    <a href="#stage-02" class="tracker-node" data-stage="2" aria-label="Go to Chapter 02: Germination" data-cursor="pointer">
      <span class="node-label">02</span>
      <span class="node-tooltip">GERMINATION</span>
    </a>
    <a href="#stage-03" class="tracker-node" data-stage="3" aria-label="Go to Chapter 03: Full Bloom" data-cursor="pointer">
      <span class="node-label">03</span>
      <span class="node-tooltip">BLOOM</span>
    </a>
  </div>
</nav>

<script>
  const trackerFill = document.getElementById('tracker-fill');
  const nodes = document.querySelectorAll<HTMLElement>('.tracker-node');

  function onScroll() {
    const scrollY = window.scrollY;
    const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
    const progress = Math.min(1, Math.max(0, scrollY / maxScroll));

    if (trackerFill) {
      trackerFill.style.height = `${progress * 100}%`;
    }

    const currentStage = progress < 0.33 ? 1 : progress < 0.72 ? 2 : 3;

    nodes.forEach((node) => {
      const stage = Number(node.dataset.stage);
      if (stage === currentStage) {
        node.classList.add('is-active');
      } else {
        node.classList.remove('is-active');
      }
    });
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .scroll-tracker {
    position: fixed;
    right: clamp(16px, 2.5vw, 32px);
    top: 50%;
    transform: translateY(-50%);
    z-index: 45;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tracker-line {
    position: absolute;
    left: 12px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: rgba(20, 45, 30, 0.08);
    border-radius: 9999px;
    overflow: hidden;
  }

  .tracker-fill {
    width: 100%;
    height: 0%;
    background: var(--color-leaf);
    transition: height 0.1s linear;
  }

  .tracker-nodes {
    display: flex;
    flex-direction: column;
    gap: 28px;
    position: relative;
    z-index: 2;
  }

  .tracker-node {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    group: relative;
  }

  .node-label {
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1.5px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    color: var(--color-text-dim);
    transition: all 0.3s var(--ease-smooth);
    box-shadow: 0 2px 8px rgba(15, 36, 25, 0.04);
  }

  .node-tooltip {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-leaf);
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.25s ease;
    pointer-events: none;
  }

  .tracker-node:hover .node-tooltip {
    opacity: 1;
    transform: translateX(0);
  }

  .tracker-node:hover .node-label {
    border-color: var(--color-leaf);
    color: var(--color-forest);
    transform: scale(1.1);
  }

  .tracker-node.is-active .node-label {
    background: var(--color-leaf);
    border-color: var(--color-leaf);
    color: #ffffff;
    box-shadow: 0 0 12px rgba(45, 106, 79, 0.4);
  }

  @media (max-width: 840px) {
    .scroll-tracker {
      display: none;
    }
  }
</style>
