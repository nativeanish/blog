---
import HudFooter from './HudFooter.astro';
---
<section class="chapter-canopy" aria-label="Chapter 03: Full Bloom">
  <div class="canopy-content">
    <div class="canopy-eyebrow">
      <span class="chapter-num">03</span>
      <span class="chapter-sep" aria-hidden="true">/</span>
      <span class="chapter-title">FULL BLOOM & HORIZON</span>
    </div>

    <h2 class="canopy-title">
      The digital space will <br />
      <span class="bloom-highlight">open soon.</span>
    </h2>

    <div class="author-statement">
      <span class="leaf-icon" aria-hidden="true">🌿</span>
      <p class="author-text">
        I am <strong>Anish</strong>. Cultivating this sanctuary from Kathmandu, Nepal.
      </p>
    </div>

    <!-- Contact & Social Connectivity -->
    <div class="contact-cluster">
      <a href="mailto:hello@guptaanish.com.np" class="contact-pill" data-cursor="pointer">
        <span class="pill-icon" aria-hidden="true">✉</span>
        <span class="pill-text">hello@guptaanish.com.np</span>
      </a>
      <a href="https://instagram.com/nativeanish" target="_blank" rel="noopener noreferrer" class="contact-pill" data-cursor="pointer">
        <span class="pill-icon" aria-hidden="true">↗</span>
        <span class="pill-text">instagram.com/nativeanish</span>
      </a>
    </div>

    <div class="canopy-badges">
      <div class="telemetry-chip">
        <span class="pulse-beacon"></span>
        <span>STATUS: BLOOMING</span>
      </div>
      <div class="telemetry-chip">
        <span>ERA: SPRING 2026</span>
      </div>
    </div>
  </div>

  <div class="canopy-footer-slot">
    <HudFooter />
  </div>
</section>

<style>
  .chapter-canopy {
    position: relative;
    width: 100%;
    min-height: calc(100vh - 120px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    text-align: center;
    padding-top: clamp(40px, 8vh, 80px);
  }

  .canopy-content {
    max-width: 820px;
    margin: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: auto;
  }

  .canopy-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--color-leaf);
    margin-bottom: 24px;
    padding: 6px 14px;
    border-radius: 9999px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    backdrop-filter: blur(12px);
  }

  .chapter-num {
    padding: 2px 7px;
    border-radius: 9999px;
    background: rgba(45, 106, 79, 0.12);
    color: var(--color-leaf);
  }

  .chapter-sep {
    color: var(--color-border);
  }

  .canopy-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6.5vw, 5.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--color-forest);
    margin-bottom: 24px;
  }

  .bloom-highlight {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 600;
    background: linear-gradient(135deg, #1b4332 0%, #2d6a4f 40%, #e5a02e 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .author-statement {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    color: var(--color-text-secondary);
    margin-bottom: 24px;
  }

  .author-text strong {
    color: var(--color-forest);
    font-weight: 700;
  }

  .leaf-icon {
    font-size: 1.3rem;
  }

  /* Contact Pills */
  .contact-cluster {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 28px;
  }

  .contact-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 22px;
    border-radius: 9999px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-forest);
    box-shadow: 0 4px 18px rgba(15, 36, 25, 0.05);
    transition: all 0.3s var(--ease-smooth);
    text-decoration: none;
  }

  .contact-pill:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-leaf);
    color: var(--color-leaf);
    box-shadow: 0 6px 24px rgba(45, 106, 79, 0.15);
    transform: translateY(-2px);
  }

  .pill-icon {
    color: var(--color-leaf);
    font-size: 0.95rem;
  }

  .canopy-badges {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .canopy-footer-slot {
    width: 100%;
    margin-top: clamp(40px, 8vh, 80px);
    pointer-events: auto;
  }

  @media (max-width: 640px) {
    .contact-cluster {
      flex-direction: column;
      width: 100%;
    }
    .contact-pill {
      width: 100%;
      justify-content: center;
      font-size: 0.75rem;
    }
  }
</style>
